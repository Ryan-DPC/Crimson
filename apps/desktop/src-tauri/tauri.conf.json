{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CRIMSON",
  "version": "2.2.3",
  "identifier": "com.laoy.crimson",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CRIMSON",
        "width": 1200,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "bin/crimson-server"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "RWRXuM5vWOPMTxIYi6oJHnKzVqWF/u3ViarQIZPPYVno+mDk0Gr5VXcn",
      "endpoints": [
        "https://github.com/Ryan-DPC/Crimson/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}