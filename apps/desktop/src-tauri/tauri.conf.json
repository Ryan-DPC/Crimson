{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CRIMSON",
  "version": "1.0.5",
  "identifier": "com.laoy.crimson",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "CRIMSON",
        "width": 1200,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1NDE3Rjg1RjBBMjMzNTgKUldSWU02THdoWDlCbGJyaEhSNFpzSmhXV0pmV2s0RENPZ2YwU2RmMG81YlZrTFhhUXFsS0hOV3EK",
      "endpoints": [
        "https://github.com/Ryan-DPC/Crimson/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

